--track0:Strength,0,100,100,1
--track1:Type,1,3,2,1
--file:

local f = file
if f == nil or f == "" then
    return
end
local ext = f:match("%.(%w+)$")
if ext == nil then
    return
end
ext = string.lower(ext)
if ext ~= "cube" and ext ~= "3dl" and ext ~= "m3d" then
    return
end

require("Simple_LUT")
-- Parsed LUTs are cached inside Simple_LUT.dll and reloaded when the file changes on disk.
local data, w, h = obj.getpixeldata()
local ok, err = Simple_LUT.LUT(data, w, h, obj.track0 / 100, obj.track1, f)
if ok then
    obj.putpixeldata(data)
else
    debug_print("Simple_LUT: " .. tostring(err) .. " (" .. f .. ")")
end
